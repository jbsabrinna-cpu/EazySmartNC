<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FileBrowserPage</class>
 <widget class="QWidget" name="FileBrowserPage">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1280</width><height>800</height></rect>
  </property>
  <property name="windowTitle"><string>EazyNC - Gestionnaire fichiers</string></property>
  <property name="styleSheet">
   <string notr="true">
/* ── Base TNC 620 ── */
QWidget#FileBrowserPage {
    background-color: #D6D6D6;
}

/* ── Barre titre page ── */
QWidget#titleBar {
    background-color: #505050;
    border-bottom: 1px solid #404040;
}
QLabel#lblPageTitle {
    color: #FFFFFF;
    font-size: 13pt;
    font-weight: bold;
    padding: 0px 8px;
}
QLabel#lblClock {
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: bold;
    padding: 0px 8px;
}
QLabel#lblConnStatus {
    color: #FFFFFF;
    font-size: 9pt;
    padding: 2px 8px;
    background-color: #00AA00;
    border: 1px solid #008800;
}

/* ── Barre chemin ── */
QWidget#pathBar {
    background-color: #EAEAEA;
    border-bottom: 1px solid #737373;
    border-top: 1px solid #B0B0B0;
}
QLabel#lblPathLabel {
    color: #000000;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px 4px;
}
QLabel#lblFullPath {
    color: #000000;
    font-size: 10pt;
    font-family: monospace;
    padding: 0px 4px;
}

/* ── En-tetes panneaux ── */
QLabel#lblTreeHeader, QLabel#lblFileHeader {
    background-color: #EAEAEA;
    color: #000000;
    font-size: 9pt;
    font-weight: bold;
    border-bottom: 1px solid #737373;
    padding: 2px 6px;
}

/* ── Panneau gauche ── */
QWidget#panelLeft {
    background-color: #D6D6D6;
    border-right: 1px solid #737373;
}

/* ── Arbre dossiers ── */
QTreeWidget#treeDir {
    background-color: #FFFFFF;
    border: none;
    font-size: 10pt;
    color: #000000;
    outline: none;
    alternate-background-color: #F5F5F5;
}
QTreeWidget#treeDir::item {
    height: 24px;
    padding-left: 2px;
    border-bottom: 1px solid #E0E0E0;
}
QTreeWidget#treeDir::item:selected {
    background-color: #0000FF;
    color: #FFFFFF;
}
QTreeWidget#treeDir::item:hover:!selected {
    background-color: #DBDBDB;
}

/* ── Panneau droit ── */
QWidget#panelRight {
    background-color: #D6D6D6;
}

/* ── Liste fichiers ── */
QTreeWidget#treeFiles {
    background-color: #FFFFFF;
    border: none;
    font-size: 10pt;
    color: #000000;
    outline: none;
    alternate-background-color: #F5F5F5;
}
QTreeWidget#treeFiles::item {
    height: 26px;
    border-bottom: 1px solid #E0E0E0;
}
QTreeWidget#treeFiles::item:selected {
    background-color: #0000FF;
    color: #FFFFFF;
}
QTreeWidget#treeFiles::item:hover:!selected {
    background-color: #DBDBDB;
}
QHeaderView::section {
    background-color: #EAEAEA;
    color: #000000;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-right: 1px solid #B0B0B0;
    border-bottom: 1px solid #737373;
    padding: 3px 6px;
}
QHeaderView::section:pressed {
    background-color: #D0D0D0;
}

/* ── Preview ── */
QWidget#panelPreview {
    background-color: #EBEBEB;
    border-top: 1px solid #737373;
}
QLabel#lblPreviewTitle {
    color: #000000;
    font-size: 9pt;
    font-weight: bold;
    background-color: #EAEAEA;
    border-bottom: 1px solid #737373;
    padding: 2px 6px;
}
QLabel#lblPreviewContent {
    color: #000000;
    font-size: 9pt;
    font-family: monospace;
    padding: 4px 8px;
    background-color: #FFFFFF;
    border: 1px solid #B0B0B0;
}
QLabel#lblPreviewType {
    color: #FFFFFF;
    font-size: 10pt;
    font-weight: bold;
    padding: 4px 12px;
}

/* ── Info bas ── */
QWidget#statusBar {
    background-color: #C8C8C8;
    border-top: 1px solid #737373;
}
QLabel#lblFileCount, QLabel#lblDiskFree, QLabel#lblCurrentPath {
    color: #000000;
    font-size: 9pt;
    padding: 0px 6px;
}

/* ── Softkeys ── */
QWidget#sk1Bar {
    background-color: #D6D6D6;
    border-top: 2px solid #737373;
}
QPushButton[softkey="true"] {
    background-color: #D6D6D6;
    color: #000000;
    border: 1px solid #737373;
    border-top: 2px solid #878787;
    border-radius: 0px;
    font-size: 9pt;
    font-weight: bold;
    padding: 4px 2px;
    min-height: 40px;
    max-height: 40px;
}
QPushButton[softkey="true"]:hover {
    background-color: #EBEBEB;
}
QPushButton[softkey="true"]:pressed {
    background-color: #BEBEBE;
}
QPushButton[softkey="true"][skactive="true"] {
    background-color: #0000FF;
    color: #FFFFFF;
    border-top: 2px solid #0000CC;
}
QPushButton[softkey="true"][skdanger="true"]:hover {
    background-color: #CC0000;
    color: #FFFFFF;
}
   </string>
  </property>

  <layout class="QVBoxLayout" name="mainVLayout">
   <property name="spacing"><number>0</number></property>
   <property name="margin"><number>0</number></property>

   <!-- ── BARRE TITRE ── -->
   <item>
    <widget class="QWidget" name="titleBar">
     <property name="minimumHeight"><number>40</number></property>
     <property name="maximumHeight"><number>40</number></property>
     <layout class="QHBoxLayout" name="titleHL">
      <property name="spacing"><number>0</number></property>
      <property name="margin"><number>0</number></property>
      <item>
       <widget class="QLabel" name="lblPageTitle">
        <property name="text"><string>EazyNC : Gestionnaire de fichiers</string></property>
       </widget>
      </item>
      <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item>
       <widget class="QLabel" name="lblConnStatus">
        <property name="text"><string>CNC12 connecte</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblClock">
        <property name="text"><string>00:00</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- ── BARRE CHEMIN ── -->
   <item>
    <widget class="QWidget" name="pathBar">
     <property name="minimumHeight"><number>26</number></property>
     <property name="maximumHeight"><number>26</number></property>
     <layout class="QHBoxLayout" name="pathHL">
      <property name="spacing"><number>4</number></property>
      <property name="leftMargin"><number>8</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>8</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <widget class="QLabel" name="lblPathLabel">
        <property name="text"><string>Chemin :</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblFullPath">
        <property name="text"><string>C:\cncm\ncfiles\</string></property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- ── CORPS : deux panneaux ── -->
   <item>
    <layout class="QHBoxLayout" name="bodyHL">
     <property name="spacing"><number>0</number></property>

     <!-- PANNEAU GAUCHE : arbre dossiers + preview -->
     <item>
      <widget class="QWidget" name="panelLeft">
       <property name="minimumWidth"><number>340</number></property>
       <property name="maximumWidth"><number>380</number></property>
       <layout class="QVBoxLayout" name="leftVL">
        <property name="spacing"><number>0</number></property>
        <property name="margin"><number>0</number></property>

        <!-- En-tete -->
        <item>
         <widget class="QLabel" name="lblTreeHeader">
          <property name="minimumHeight"><number>24</number></property>
          <property name="maximumHeight"><number>24</number></property>
          <property name="text"><string>REPERTOIRES</string></property>
         </widget>
        </item>

        <!-- Arbre dossiers -->
        <item>
         <widget class="QTreeWidget" name="treeDir">
          <property name="headerHidden"><bool>true</bool></property>
          <property name="rootIsDecorated"><bool>true</bool></property>
          <property name="alternatingRowColors"><bool>true</bool></property>
          <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
          <property name="indentation"><number>16</number></property>
          <column><property name="text"><string>Nom</string></property></column>
         </widget>
        </item>

        <!-- Zone preview : FilePreviewWidget injecte en C++ -->
        <item>
         <widget class="QWidget" name="panelPreview">
          <property name="minimumHeight"><number>200</number></property>
          <property name="maximumHeight"><number>280</number></property>
          <property name="styleSheet"><string>background:#FFFFFF; border-top:1px solid #737373;</string></property>
         </widget>
        </item>

       </layout>
      </widget>
     </item>

     <!-- PANNEAU DROIT : liste fichiers -->
     <item>
      <widget class="QWidget" name="panelRight">
       <layout class="QVBoxLayout" name="rightVL">
        <property name="spacing"><number>0</number></property>
        <property name="margin"><number>0</number></property>

        <!-- En-tete -->
        <item>
         <widget class="QLabel" name="lblFileHeader">
          <property name="minimumHeight"><number>24</number></property>
          <property name="maximumHeight"><number>24</number></property>
          <property name="text"><string>FICHIERS</string></property>
         </widget>
        </item>

        <!-- Liste fichiers -->
        <item>
         <widget class="QTreeWidget" name="treeFiles">
          <property name="rootIsDecorated"><bool>false</bool></property>
          <property name="alternatingRowColors"><bool>true</bool></property>
          <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
          <property name="sortingEnabled"><bool>true</bool></property>
          <property name="uniformRowHeights"><bool>true</bool></property>
          <column><property name="text"><string>Nom fichier</string></property></column>
          <column><property name="text"><string>Type</string></property></column>
          <column><property name="text"><string>Taille</string></property></column>
          <column><property name="text"><string>Date</string></property></column>
          <column><property name="text"><string>Heure</string></property></column>
         </widget>
        </item>

       </layout>
      </widget>
     </item>

    </layout>
   </item>

   <!-- ── BARRE STATUT ── -->
   <item>
    <widget class="QWidget" name="statusBar">
     <property name="minimumHeight"><number>24</number></property>
     <property name="maximumHeight"><number>24</number></property>
     <layout class="QHBoxLayout" name="statusHL">
      <property name="spacing"><number>0</number></property>
      <property name="leftMargin"><number>8</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>8</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <widget class="QLabel" name="lblFileCount">
        <property name="text"><string>0 objet(s)</string></property>
       </widget>
      </item>
      <item>
       <widget class="QFrame" name="statusSep1">
        <property name="frameShape"><enum>QFrame::VLine</enum></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblCurrentPath">
        <property name="text"><string>C:\cncm\ncfiles\</string></property>
       </widget>
      </item>
      <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item>
       <widget class="QLabel" name="lblDiskFree">
        <property name="text"><string>-- Go libres</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- ── SOFTKEYS ── -->
   <item>
    <widget class="QWidget" name="sk1Bar">
     <property name="minimumHeight"><number>48</number></property>
     <property name="maximumHeight"><number>48</number></property>
     <layout class="QHBoxLayout" name="sk1HL">
      <property name="spacing"><number>0</number></property>
      <property name="margin"><number>4</number></property>

      <item>
       <widget class="QPushButton" name="skPageUp">
        <property name="text"><string>PAGE
haut</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Remonter dans la liste</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skPageDown">
        <property name="text"><string>PAGE
bas</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Descendre dans la liste</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skDelete">
        <property name="text"><string>EFFACER</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="skdanger" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Supprimer le fichier selectionne</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skCopy">
        <property name="text"><string>COPIER</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Copier le fichier selectionne</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skSelectType">
        <property name="text"><string>SELECT.
TYPE</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Filtrer par type de fichier</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skNewFile">
        <property name="text"><string>NOUVEAU
FICHIER</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Creer un nouveau programme</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skNewDir">
        <property name="text"><string>NOUVEAU
DOSSIER</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Creer un nouveau dossier</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skRename">
        <property name="text"><string>RENOMMER</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Renommer le fichier selectionne</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="skOpen">
        <property name="text"><string>OUVRIR</string></property>
        <property name="softkey" stdset="0"><bool>true</bool></property>
        <property name="skactive" stdset="0"><bool>true</bool></property>
        <property name="toolTip"><string>Ouvrir le fichier selectionne</string></property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

  </layout>
 </widget>
